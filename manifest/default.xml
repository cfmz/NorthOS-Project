<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <remote name="github" fetch="https://github.com/" />
  <remote name="north" fetch="https://github.com/твой_ник/" />

  <!-- Базовая ветка LineageOS (Android 13/14) -->
  <default revision="lineage-21.0" remote="github" sync-j="4" />

  <!-- Твой device tree и vendor для Redmi 9 Prime (lancelot) -->
  <project name="AndroidBlobs/device_xiaomi_lancelot" path="device/xiaomi/lancelot" remote="github" />
  <project name="AndroidBlobs/vendor_xiaomi_lancelot" path="vendor/xiaomi/lancelot" remote="github" />

  <!-- Модули NorthOS (пока просто заготовки) -->
  <project name="NorthOS-Project" path="vendor/north" remote="north" />
</manifest>
